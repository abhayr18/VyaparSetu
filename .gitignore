# Dependencies
node_modules/

# Production builds
dist/

# Electron installer output (electron-builder)
release/

# SQLite databases
*.db
database/vyapaarsetu.db
# WAL mode keeps recent writes in these two sidecars, so `*.db` does not cover
# them and a `git add -A` would commit a fragment of real client data.
*.db-wal
*.db-shm

# Drive credentials (matched in any directory, wherever the tokens land)
drive_tokens.json

# Local backups
backups/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE configurations
.vscode/
.idea/
.DS_Store
Thumbs.db

# Licensing — MUST NOT be committed.
# The private key can forge licenses for every install; licenses.json is the
# customer register; license.json is a machine's local activation record.
tools/keys/
tools/licenses.json
*.pem
backend/database/license.json
license.json
